# Copy to .env and fill in your secrets. Loaded automatically from the working directory.
# Shell environment variables take precedence over this file.
SERPAPI_KEY=
SLACK_WEBHOOK_URL=
SEARCH_CATEGORIES=electronics,home,kitchen,toys,tools,outdoor
MAX_DEALS=10
ALLOWED_RETAILERS=Amazon,Walmart,Target
MIN_RATING=4
MIN_DISCOUNT=0
SEARCH_LOCATION=San Jose, California, United States
SCORE_DISCOUNT_WEIGHT=1
SCORE_RATING_WEIGHT=2
SCORE_REVIEW_WEIGHT=1
SCORE_VALUE_WEIGHT=2

# Per-category rules override SEARCH_CATEGORIES when set.
SEARCH_PROFILES_FILE=search-profiles.json
